# Образ для разработки frontend (Vite + HMR)

FROM node:24.14.1-alpine3.23 AS dev

# Переменные окружения для pnpm
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV PNPM_DISABLE_SELF_UPDATE_CHECK=true
ENV PNPM_STORE_PATH=/pnpm/store
ENV CI=true

WORKDIR /app

# Включаем pnpm через Corepack
RUN corepack enable

FROM dev AS build

# Копируем конфигурацию workspace и lockfile
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./

# Предварительно загружаем все зависимости в кэш
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm fetch

# Копируем package.json frontend
COPY frontend/package.json ./frontend/

# Устанавливаем зависимости (включая devDependencies для Vite)
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --offline --frozen-lockfile --filter @mse/frontend

# Копируем исходный код frontend
COPY frontend ./frontend

EXPOSE 8080

# Запуск Vite dev-сервера
CMD ["pnpm", "--filter", "@mse/frontend", "run", "dev"]
