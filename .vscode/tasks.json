{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Установка зависимостей",
      "command": "pnpm",
      "args": [
        "i"
      ],
      "type": "shell",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Сборка проекта",
      "command": "pnpm",
      "args": [
        "build"
      ],
      "type": "shell",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Запуск проекта",
      "command": "pnpm",
      "args": [
        "start"
      ],
      "type": "shell",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Запуск в dev режиме",
      "command": "pnpm",
      "args": [
        "dev"
      ],
      "type": "shell",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Запуск Docker Compose",
      "command": "docker-compose",
      "args": [
        "up",
        "--build"
      ],
      "type": "shell",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
  ]
}