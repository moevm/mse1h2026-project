{
  "name": "@mse/backend",
  "version": "0.0.1",
  "description": "MSE backend.",
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "build": "nest build --preserveWatchOutput",
    "start": "nest start --preserveWatchOutput",
    "start:dev": "nest start --watch --preserveWatchOutput",
    "start:prod": "node dist/main.js",
    "lint": "eslint --cache src",
    "format": "prettier --cache --write src",
    "format:check": "prettier --cache --check src",
    "typecheck": "tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@mse/database": "workspace:*",
    "@nestjs/common": "^11.1.14",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.14",
    "@nestjs/platform-express": "^11.1.14",
    "@prisma/adapter-mariadb": "^7.4.1",
    "@prisma/client": "^7.4.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@types/node": "^25.3.0",
    "dotenv": "^17.3.1",
    "prisma": "^7.4.1",
    "typescript": "^5.9.3"
  }
}
