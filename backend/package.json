{
  "name": "@mse/backend",
  "version": "0.0.1",
  "description": "MSE backend.",
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "build": "prisma migrate deploy && prisma generate && nest build --preserveWatchOutput",
    "start": "prisma migrate deploy && prisma generate && nest start --preserveWatchOutput",
    "start:dev": "prisma migrate dev && concurrently -k -n prisma,Nest -c red,green \"prisma generate --watch\" \"nest start --watch --preserveWatchOutput\"",
    "start:prod": "node dist/main.js",
    "lint": "eslint --cache src",
    "format": "prettier --cache --write src",
    "format:check": "prettier --cache --check src",
    "typecheck": "prisma db:deploy && tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.14",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.14",
    "@nestjs/platform-express": "^11.1.14",
    "@prisma/adapter-mariadb": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.0",
    "dotenv": "^17.3.1",
    "prisma": "^7.4.1",
    "@types/passport-local": "^1.0.38",
    "typescript": "^5.9.3"
  }
}
