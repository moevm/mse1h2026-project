{
  "name": "@mse/backend",
  "version": "0.0.1",
  "description": "MSE backend.",
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "build": "nest build --preserveWatchOutput",
    "start": "nest start --preserveWatchOutput",
    "start:dev": "concurrently -n prisma,Nest -c red,green \"prisma generate --watch\" \"nest start --watch --preserveWatchOutput\"",
    "start:prod": "node dist/main.js",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "lint": "eslint --cache src",
    "format": "prettier --cache --write src",
    "format:check": "prettier --cache --check src",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.build.json",
    "pre-commit-check": "pnpm typecheck && pnpm lint && pnpm format",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.59.1",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.17",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.17",
    "@nestjs/terminus": "^11.1.1",
    "@prisma/adapter-mariadb": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "axios": "^1.14.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "prisma": "^7.6.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@nestjs/testing": "^11.1.17",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.0",
    "@types/passport-local": "^1.0.38",
    "dotenv": "^17.3.1",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
