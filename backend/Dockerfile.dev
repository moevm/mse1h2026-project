# Образ для разработки backend
FROM node:lts-alpine AS dev

# Переменные окружения для pnpm
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

WORKDIR /app

# Включаем pnpm через Corepack
RUN corepack enable

# Копируем конфигурацию workspace и lockfile
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./

# Копируем package.json зависимых пакетов
COPY backend/package.json ./backend/

# Устанавливаем зависимости backend
RUN pnpm install --frozen-lockfile --filter @mse/backend

# Копируем исходный код backend
COPY backend ./backend

RUN pnpm --filter @mse/backend run db:generate
RUN pnpm --filter @mse/backend run build

EXPOSE 3000

# Запуск NestJS в watch-режиме
CMD ["pnpm", "--filter", "@mse/backend", "start:dev"]
